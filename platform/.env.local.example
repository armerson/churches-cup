# Supabase project (create at https://supabase.com/dashboard) — never commit the real .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS entirely — used by lib/bracket.ts's advanceBracket() and
# the Stripe webhook handler, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect (test mode keys from https://dashboard.stripe.com/test/apikeys —
# never use live keys until this is actually ready to take real payments)
STRIPE_SECRET_KEY=
# From the webhook endpoint's settings in the Stripe dashboard (or the
# Stripe CLI's `stripe listen` output when testing locally)
STRIPE_WEBHOOK_SECRET=
# Used to build Stripe success/cancel/return URLs — set to this app's
# real deployed URL once there is one
NEXT_PUBLIC_SITE_URL=http://localhost:3000
